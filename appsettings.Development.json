{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=smartqueue.v2.dev.db",
    "PostgresConnection": "Host=localhost;Port=5432;Database=smartqueue_dev;Username=smartqueue;Password=smartqueue"
  },
  "Jwt": {
    "Key": "SmartQueue-Super-Secret-Jwt-Key-For-Development-Only-Replace",
    "Issuer": "SmartQueueAPI",
    "Audience": "SmartQueueClients",
    "ExpiresMinutes": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
